# Ignore generated batch artifacts
**/*_batch.zip

echo ".env" >> .gitignore

cat >> .git/info/exclude <<'EOF'
.batch_*_backup_*/
.batch_*_test_backup_*/
Batch_A_*/
Batch_B_*/
Batch_C_*/
Batch_A_*.zip
Batch_B_*.zip
Batch_C_*.zip
batch_*_install_report.json
batch_*_schema.sql
batch_*_verified_input.txt
EOF

