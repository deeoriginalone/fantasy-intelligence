{% extends "base.html" %}

{% block content %}
<style>
*{box-sizing:border-box}.draft-board-page{color:#222}.draft-board-page h1{margin-top:0}.card{background:#fff;padding:20px;border-radius:10px;margin-bottom:20px;box-shadow:0 2px 8px rgba(0,0,0,.06)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-bottom:20px}.grid .card{margin-bottom:0}.highlight{background:#e8f5e9;border-left:6px solid #2e7d32;padding:18px;border-radius:8px}.highlight h2{color:#2e7d32;margin:4px 0 8px}.agent-card{border-top:5px solid #283593}.agent-header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.agent-header h2{margin:4px 0 0}.agent-label{color:#283593;font-size:.75rem;font-weight:bold;letter-spacing:1.2px}.agent-status{background:#d4edda;color:#1b5e20;border-radius:999px;padding:6px 10px;font-size:.75rem;font-weight:bold}.recommendation-label{color:#2e7d32;font-size:.8rem;font-weight:bold;letter-spacing:.8px;text-transform:uppercase}.player-details{margin-bottom:12px}.agent-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:14px 0}.metric{background:rgba(255,255,255,.72);border-radius:8px;padding:10px}.metric-total{grid-column:1/-1;border:1px solid #c5cae9;background:#f0f1ff}.metric-label{display:block;color:#666;font-size:.72rem;font-weight:bold;letter-spacing:.6px;text-transform:uppercase}.metric-value{display:block;margin-top:4px;font-size:1.05rem;font-weight:bold}.draft-score{color:#283593}.agent-reason{margin:10px 0 0;line-height:1.5}.tier-alert{margin-top:12px;background:#fff3cd;border-left:4px solid #ff9800;padding:10px;border-radius:6px;line-height:1.4}.scarcity-value{font-weight:bold}.scarcity-high{color:#c62828}.scarcity-medium{color:#ef6c00}.scarcity-low{color:#2e7d32}.need{display:inline-block;margin:4px;padding:8px 12px;border-radius:8px;background:#fff3cd}.need.filled{background:#d4edda}.roster-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.slot{padding:12px;background:#eef4ff;border-radius:8px}.empty-slot{color:#777}.target-list{display:flex;flex-wrap:wrap;gap:12px}.target{background:#fff8e1;border:1px solid #ffe082;padding:10px 14px;border-radius:8px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse}th,td{border-bottom:1px solid #ddd;padding:10px;text-align:left;vertical-align:middle}th{background:#ececec}tbody tr:hover{background:#f7f9fc}tr.drafted{background:#eee;color:#777}form.inline-form{display:inline-block;margin:0 5px 4px 0}button{border:0;border-radius:6px;padding:8px 12px;cursor:pointer;font-weight:bold}.star{background:#fff3cd}.draft{background:#d4edda}.undraft,.remove{background:#f8d7da}.team{background:#e8eaf6;color:#283593}.muted{color:#666;font-style:italic}@media(max-width:700px){.agent-header{align-items:flex-start}.agent-metrics{grid-template-columns:1fr}th,td{padding:8px}}
</style>

<div class="draft-board-page">
<h1>🏈 My Draft Board</h1>
<div class="grid">
<section class="card"><h2>Draft Board Summary</h2><p><strong>Total Players:</strong> {{ players|length }}</p><p><strong>Available:</strong> {{ available_players|length }}</p><p><strong>Drafted:</strong> {{ drafted_count }}</p><p><strong>On My Team:</strong> {{ roster|length }}</p></section>

<section class="card"><h2>🏆 Best Available</h2>{% if best_available %}<div class="highlight"><h2>{{ best_available[1] }}</h2><p>Overall Rank #{{ best_available[0] }} · {{ best_available[2] }} · {{ best_available[3] or "FA" }}</p></div>{% else %}<p class="muted">No available players.</p>{% endif %}</section>

<section class="card agent-card">
<div class="agent-header"><div><span class="agent-label">FANTASY INTELLIGENCE</span><h2>Draft Agent</h2></div><span class="agent-status">ACTIVE</span></div>
{% if team_recommendation %}
{% set recommended_position = team_recommendation[2] %}
{% set recommendation_need = need_score.get(recommended_position,25) %}
{% set recommendation_scarcity = scarcity_labels.get(recommended_position,"LOW") %}
{% set recommendation_scarcity_score = scarcity_score.get(recommended_position,25) if scarcity_score is defined else 25 %}
{% set recommendation_rank_score = 101 - team_recommendation[0] if team_recommendation[0] <= 100 else 0 %}
{% set recommendation_tier_bonus = tier_bonus.get(recommended_position, 0) %}
{% set recommendation_draft_score = recommendation_rank_score + recommendation_need + recommendation_scarcity_score + recommendation_tier_bonus %}
<div class="highlight"><div class="recommendation-label">Recommended Pick</div><h2>{{ team_recommendation[1] }}</h2><p class="player-details">Overall Rank #{{ team_recommendation[0] }} · {{ recommended_position }} · {{ team_recommendation[3] or "FA" }}</p>
<div class="agent-metrics">
<div class="metric"><span class="metric-label">Rank Score</span><span class="metric-value">{{ recommendation_rank_score }}</span></div>
<div class="metric"><span class="metric-label">Need Score</span><span class="metric-value">{{ recommendation_need }}</span></div>
<div class="metric"><span class="metric-label">Scarcity</span><span class="metric-value scarcity-{{ recommendation_scarcity|lower }}">{{ recommendation_scarcity }}</span></div>
<div class="metric"><span class="metric-label">Scarcity Score</span><span class="metric-value">{{ recommendation_scarcity_score }}</span></div>
<div class="metric"><span class="metric-label">Tier Risk Bonus</span><span class="metric-value">{{ recommendation_tier_bonus }}</span></div>
<div class="metric metric-total"><span class="metric-label">Draft Score</span><span class="metric-value draft-score">{{ agent_draft_score }}</span></div>
</div>
{% if tier_alert %}<div class="tier-alert">🚨 {{ tier_alert }}</div>{% endif %}
<div class="agent-reason"><strong>Why this pick?</strong><ul>{% for reason in recommendation_reasons %}<li>{{ reason }}</li>{% endfor %}</ul></div>
</div>{% else %}<p class="muted">No recommendation is currently available.</p>{% endif %}
</section>

<section class="card"><h2>📉 Position Scarcity</h2>{% for position in ["QB","RB","WR","TE"] %}{% set label = scarcity_labels.get(position,"LOW") %}<p><strong>{{ position }}:</strong> {{ scarcity.get(position,0) }} <span class="scarcity-value scarcity-{{ label|lower }}">({{ label }})</span></p>{% endfor %}</section>
</div>

<section class="card">
<h2>🏅 Top 5 Recommendations</h2>
<p class="muted">Players are ranked by overall value, roster need, positional scarcity, and tier-drop risk.</p>
<div class="table-wrap"><table><thead><tr><th>#</th><th>Player</th><th>Pos</th><th>Overall</th><th>Rank</th><th>Need</th><th>Scarcity</th><th>Tier Bonus</th><th>Draft Score</th></tr></thead><tbody>
{% for candidate in top_recommendations %}{% set player = candidate.player %}<tr{% if loop.first %} style="background:#e8f5e9"{% endif %}><td>{{ loop.index }}</td><td><strong>{{ player[1] }}</strong></td><td>{{ player[2] }}</td><td>#{{ player[0] }}</td><td>{{ candidate.rank_score }}</td><td>{{ candidate.need_score }}</td><td>{{ candidate.scarcity_score }}</td><td>{{ candidate.tier_bonus }}</td><td><strong>{{ candidate.draft_score }}</strong></td></tr>{% endfor %}
</tbody></table></div>
</section>

<section class="card">
<h2>🧱 Tier Intelligence</h2>
{% if team_recommendation and recommended_tier %}
<p><strong>{{ team_recommendation[2] }} tier:</strong> Tier {{ recommended_tier }}</p>
<p><strong>Players left in tier:</strong> {{ recommended_tier_remaining }}</p>
{% endif %}
<div class="table-wrap"><table><thead><tr><th>Position</th><th>Tier 1</th><th>Tier 2</th><th>Tier 3</th><th>Tier 4</th><th>Tier 5</th></tr></thead><tbody>
{% for position in ["QB", "RB", "WR", "TE"] %}<tr><td><strong>{{ position }}</strong></td>{% for tier in [1,2,3,4,5] %}<td>{{ tier_counts[position][tier] }}</td>{% endfor %}</tr>{% endfor %}
</tbody></table></div>
{% if tier_alert %}<div class="tier-alert">🚨 {{ tier_alert }}</div>{% endif %}
</section>

<section class="card">
<h2>🤖 Opponent Pressure Index</h2>
{% if pick_forecast.next_pick %}
<p><strong>Teams drafting before your next pick:</strong> {{ pick_forecast.teams_before_next_pick|length }}</p>
{% if pick_forecast.teams_before_next_pick %}<p class="muted">{{ pick_forecast.teams_before_next_pick|join(", ") }}</p>{% endif %}
<div class="roster-grid">{% for position in ["QB", "RB", "WR", "TE"] %}<div class="slot"><strong>{{ position }}</strong><br>Pressure index: {{ pick_forecast.position_pressure[position] }}<br>Teams needing depth: {{ pick_forecast.teams_needing_position[position] }}<br>Projected picks: {{ pick_forecast.projected_gone[position] }}</div>{% endfor %}</div>
{% else %}<p class="muted">Opponent pressure will appear when Sleeper exposes the next usable draft turn.</p>{% endif %}
</section>

<section class="card">
<h2>🔭 Next-Pick Forecast</h2>
{% if pick_forecast.next_pick %}
<p><strong>Current overall pick:</strong> {{ pick_forecast.current_pick }}</p>
<p><strong>Your next pick:</strong> {{ pick_forecast.next_pick }}</p>
<p><strong>Selections before your pick:</strong> {{ pick_forecast.picks_until_next }}</p>
<div class="roster-grid">{% for position in ["QB", "RB", "WR", "TE"] %}<div class="slot"><strong>{{ position }}</strong><br>Projected gone: {{ pick_forecast.projected_gone[position] }}<br>Projected remaining: {{ pick_forecast.projected_remaining[position] }}</div>{% endfor %}</div>
{% if pick_forecast.projected_picks %}<h3>Projected Opponent Picks</h3><div class="table-wrap"><table><thead><tr><th>Pick</th><th>Team</th><th>Player</th><th>Position</th><th>Rank</th></tr></thead><tbody>{% for pick in pick_forecast.projected_picks %}<tr><td>{{ pick.overall_pick }}</td><td>{{ pick.team }}</td><td>{{ pick.player }}</td><td>{{ pick.position }}</td><td>{{ pick.rank }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
<p class="muted">Forecast simulates opponent selections using roster targets, positional need, and overall rank. It is a planning estimate, not a prediction guarantee.</p>
{% elif pick_forecast.error %}<p class="muted">Forecast unavailable: {{ pick_forecast.error }}</p>
{% else %}<p class="muted">Next-pick forecast will appear after Sleeper publishes a usable draft order.</p>{% endif %}
</section>

<section class="card">
<h2>🎯 Strategic Roster Targets</h2>
<div class="roster-grid">{% for position in ["QB", "RB", "WR", "TE"] %}{% set progress = roster_progress[position] %}<div class="slot"><strong>{{ position }}: {{ progress.current }} / {{ progress.target }}</strong><br>Missing: {{ progress.missing }}<br>Need score: {{ need_score[position] }}</div>{% endfor %}</div>
<p class="muted">Targets guide offensive depth and are separate from Sleeper starting-lineup requirements.</p>
</section>

<section class="card"><h2>🏆 My Team</h2><div class="roster-grid">{% for slot,player in roster_slots.items() %}<div class="slot"><strong>{{ slot }}:</strong> {% if player %}{{ player[1] }} <form class="inline-form" method="POST" action="{{ url_for('remove_from_team') }}"><input type="hidden" name="roster_id" value="{{ player[0] }}"><button class="remove" type="submit">Remove</button></form>{% else %}<span class="empty-slot">--</span>{% endif %}</div>{% endfor %}</div>{% if bench %}<h3>Bench</h3><div class="roster-grid">{% for player in bench %}<div class="slot"><strong>{{ player[2] }}:</strong> {{ player[1] }} <form class="inline-form" method="POST" action="{{ url_for('remove_from_team') }}"><input type="hidden" name="roster_id" value="{{ player[0] }}"><button class="remove" type="submit">Remove</button></form></div>{% endfor %}</div>{% endif %}</section>

<section class="card"><h2>⚠️ Team Needs</h2>{% for slot in roster_slots %}<span class="need {% if roster_slots[slot] %}filled{% endif %}">{% if roster_slots[slot] %}✅{% else %}❌{% endif %} {{ slot }}</span>{% endfor %}</section>

<section class="card"><h2>🎯 Draft Targets</h2>{% if draft_targets %}<div class="target-list">{% for player in draft_targets %}<div class="target">⭐ #{{ player[0] }} {{ player[1] }} ({{ player[2] }} · {{ player[3] or "FA" }})</div>{% endfor %}</div>{% else %}<p class="muted">No available targets.</p>{% endif %}</section>

<section class="card"><h2>Player Draft Board</h2><div class="table-wrap"><table><thead><tr><th>Target</th><th>Rank</th><th>Player</th><th>Position</th><th>Team</th><th>Status</th><th>Actions</th></tr></thead><tbody>
{% for player in players %}<tr class="{% if player[5] %}drafted{% endif %}"><td>{% if player[4] %}⭐{% else %}☆{% endif %}</td><td>{{ player[0] }}</td><td>{{ player[1] }}</td><td>{{ player[2] }}</td><td>{{ player[3] or "FA" }}</td><td>{% if player[5] %}✅ Drafted{% else %}❌ Available{% endif %}</td><td>
<form class="inline-form" method="POST" action="{{ url_for('toggle_star') }}"><input type="hidden" name="player_name" value="{{ player[1] }}"><button class="star" type="submit">{% if player[4] %}Unstar{% else %}Star{% endif %}</button></form>
<form class="inline-form" method="POST" action="{{ url_for('toggle_drafted') }}"><input type="hidden" name="player_name" value="{{ player[1] }}"><button class="{% if player[5] %}undraft{% else %}draft{% endif %}" type="submit">{% if player[5] %}Undraft{% else %}Draft{% endif %}</button></form>
<form class="inline-form" method="POST" action="{{ url_for('add_to_team') }}"><input type="hidden" name="player_name" value="{{ player[1] }}"><input type="hidden" name="position" value="{{ player[2] }}"><button class="team" type="submit">Add To Team</button></form>
</td></tr>{% endfor %}
</tbody></table></div></section>
</div>
{% endblock %}
