[Unit]
Description=Fantasy Intelligence W6 opportunity and snap-share evidence refresh
# Keeps the stored nflverse role evidence that /waivers reads (targets, carries, offensive snap share) current by running the existing
# explicit refresh; the page itself only reads stored rows. Each source publishes in one transaction, and a source that fails keeps its
# prior rows and retrieval time. A failed or partial refresh exits nonzero, so systemd records the run as failed and the journal keeps
# the JSON result. The command loads the repository .env itself, as the schedule refresh does.
[Service]
Type=oneshot
WorkingDirectory=/home/deeoriginalone/fantasy-intelligence
ExecStart=/home/deeoriginalone/fantasy-intelligence/venv/bin/python /home/deeoriginalone/fantasy-intelligence/refresh_opportunity_evidence.py
TimeoutStartSec=15min
